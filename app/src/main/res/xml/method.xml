<?xml version="1.0" encoding="utf-8"?>
<input-method xmlns:android="http://schemas.android.com/apk/res/android"
    android:settingsActivity="com.m929.lowkeyboard.SettingsActivity">
    <!-- Подтип "English (US), клавиатура": нужен, чтобы систему считала клавиатуру пригодной для включения по умолчанию.
         Реальные языки переключаются самой клавиатурой (глобус), так что одного подтипа достаточно. -->
    <subtype
        android:label="@string/subtype"
        android:imeSubtypeLocale="en_US"
        android:imeSubtypeMode="keyboard" />
</input-method>
